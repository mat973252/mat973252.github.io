---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Mat · Less magic. More runtime.',
  description = 'Mat builds the boring parts that keep AI agents alive — permissions, recovery, and evals.',
  image = '/assets/images/mat-home-og.png',
} = Astro.props;

const pageTitle = title === 'Mat · Less magic. More runtime.' ? title : `${title} · Mat`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="Mat" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/assets/images/mat-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="site-shell header-inner">
        <a class="brand" href="/" aria-label="Mat 首页">mat<span class="brand-dot">.</span></a>
        <nav aria-label="主导航">
          <a href="/#work">work</a>
          <a href="/#notes">notes</a>
          <a href="https://github.com/mat973252" target="_blank" rel="noopener noreferrer">github</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="site-shell footer-inner">
        <a class="footer-brand" href="/">mat<span class="brand-dot">.</span></a>
        <span>© 2026 Mat</span>
        <a href="https://github.com/mat973252" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        <span class="footer-thought">Better tools. Calmer days.<span class="mint-dot" aria-hidden="true"></span></span>
      </div>
    </footer>
  </body>
</html>
